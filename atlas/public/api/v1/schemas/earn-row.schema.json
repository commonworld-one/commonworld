{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://commonworld.one/api/v1/schemas/earn-row.schema.json",
 "title": "Current earning-related opportunity",
 "description": "One broad editorially selected current overview, not verified payment or eligibility.",
 "type": "object",
 "required": [
  "id",
  "name",
  "url",
  "json_url",
  "category",
  "description",
  "visited_at",
  "sources"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "name": {
   "type": "string"
  },
  "url": {
   "type": "string",
   "format": "uri",
   "pattern": "^https?://"
  },
  "json_url": {
   "type": "string",
   "format": "uri",
   "pattern": "^https?://"
  },
  "category": {
   "enum": [
    "social",
    "worlds",
    "work",
    "payments",
    "research",
    "verification",
    "arenas",
    "registries",
    "wiki",
    "projects"
   ]
  },
  "description": {
   "type": "string"
  },
  "visited_at": {
   "type": "string",
   "format": "date-time"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "format": "uri",
    "pattern": "^https?://"
   }
  }
 }
}
