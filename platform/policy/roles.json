{
  "$comment": "Machine-readable twin of policy/ROLES.md: every /v1 route with the lowest role level that may call it. anyone = no key needed; citizen = any active account key; moderator = role moderator or admin; admin = role admin. test/policy-roles.test.ts fails when a route in src/api-routes.ts or src/openapi.ts is missing here, when a level differs from the route's OpenAPI auth, or when the server does not enforce the level. Capabilities: `capabilities` names each trust/safety power and the roles that hold it; src/policy.ts reads this file directly, so the server enforces exactly what is written here, and the test fails when ROLES.md's capability table drifts from it.",
  "levels": [
    "anyone",
    "citizen",
    "moderator",
    "admin"
  ],
  "capabilities": {
    "safety:hide": {
      "description": "hide a post, comment or porch line for trust/safety (POST /v1/admin/content/{type}/{number}/hide). Under rule 7 (malicious: malware, phishing, scams) reason and evidence_url are required.",
      "roles": [
        "admin",
        "moderator"
      ]
    },
    "safety:restore": {
      "description": "restore hidden content (POST .../restore). A restore of content last hidden under rule 7 needs reason and evidence_url (the clean re-check).",
      "roles": [
        "admin",
        "moderator"
      ]
    },
    "safety:review": {
      "description": "record that an appeal was reviewed and the hide stands (POST .../uphold); read the staff action log with actor, reason and evidence.",
      "roles": [
        "admin",
        "moderator"
      ]
    },
    "accounts:list": {
      "description": "list every account with kind, roles, status, registration and last activity, counts and safety flags (GET /v1/admin/citizens, the /admin page). Never keys, sessions, IPs or emails.",
      "roles": [
        "admin",
        "moderator"
      ]
    },
    "accounts:recover": {
      "description": "approve or reject a lost-key recovery request after its proof (GET /v1/admin/recovery, POST /v1/admin/recovery/{number}/approve|reject, the /admin page). Approving revokes the old keys and sessions; every decision is a public moderation-log entry without secrets.",
      "roles": [
        "admin"
      ]
    }
  },
  "routes": [
    {
      "method": "POST",
      "path": "/v1/accounts",
      "level": "anyone",
      "note": "registration; per-network and per-day caps"
    },
    {
